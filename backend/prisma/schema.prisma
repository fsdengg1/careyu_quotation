generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  password    String
  name        String
  role        String      @default("admin")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  quotations  Quotation[]

  @@map("users")
}

model Customer {
  id            String      @id @default(uuid())
  customerName  String      @map("customer_name")
  companyName   String      @map("company_name")
  address       String      @default("")
  city          String      @default("")
  state         String      @default("")
  country       String      @default("India")
  gstNumber     String      @default("") @map("gst_number")
  contactPerson String      @default("") @map("contact_person")
  email         String      @default("")
  phone         String      @default("")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  quotations    Quotation[]

  @@map("customers")
}

model CompanySettings {
  id                         String   @id @default("default")
  companyName                String   @map("company_name")
  address                    String
  website                    String
  email                      String
  phone                      String
  logoPath                   String   @default("/assets/careyu-logo.png") @map("logo_path")
  defaultGst                 Decimal  @map("default_gst") @db.Decimal(5, 2)
  defaultQuotationValidity   String   @map("default_quotation_validity") @db.Text
  defaultPaymentTerms        String   @map("default_payment_terms") @db.Text
  defaultWarranty            String   @map("default_warranty") @db.Text
  defaultAmcNote             String   @map("default_amc_note") @db.Text
  defaultSoftwareDevelopment String   @map("default_software_development") @db.Text
  signatureName              String   @map("signature_name")
  signatureDesignation       String   @map("signature_designation")
  footerTagline              String   @map("footer_tagline")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model Quotation {
  id                 String           @id @default(uuid())
  quotationNumber    String           @unique @map("quotation_number")
  quotationDate      DateTime         @map("quotation_date") @db.Date
  projectName        String           @map("project_name")
  projectLocation    String           @map("project_location")
  clientName         String           @map("client_name")
  clientCompany      String           @map("client_company")
  customerId         String?          @map("customer_id")
  customer           Customer?        @relation(fields: [customerId], references: [id])
  subtotal           Decimal          @default(0) @db.Decimal(14, 2)
  freight            Decimal          @default(0) @db.Decimal(14, 2)
  installationCharge Decimal          @default(0) @map("installation_charge") @db.Decimal(14, 2)
  gstPercentage      Decimal          @default(18) @map("gst_percentage") @db.Decimal(5, 2)
  gstAsExtra         Boolean          @default(true) @map("gst_as_extra")
  gstAmount          Decimal          @default(0) @map("gst_amount") @db.Decimal(14, 2)
  grandTotal         Decimal          @default(0) @map("grand_total") @db.Decimal(14, 2)
  amountInWords      String           @default("") @map("amount_in_words")
  status             String           @default("draft")
  companySnapshot    Json             @map("company_snapshot")
  pdfPath            String?          @map("pdf_path")
  createdById        String?          @map("created_by_id")
  createdBy          User?            @relation(fields: [createdById], references: [id])
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  items              QuotationItem[]
  terms              QuotationTerms?

  @@index([status])
  @@index([quotationDate])
  @@index([clientCompany])
  @@map("quotations")
}

model QuotationItem {
  id           String    @id @default(uuid())
  quotationId  String    @map("quotation_id")
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serialNumber Int       @map("serial_number")
  description  String    @db.Text
  unitPrice    Decimal   @map("unit_price") @db.Decimal(14, 2)
  quantity     Decimal   @db.Decimal(12, 2)
  totalAmount  Decimal   @map("total_amount") @db.Decimal(14, 2)

  @@map("quotation_items")
}

model QuotationTerms {
  id                  String    @id @default(uuid())
  quotationId         String    @unique @map("quotation_id")
  quotation           Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  softwareDevelopment String    @map("software_development") @db.Text
  quotationValidity   String    @map("quotation_validity") @db.Text
  paymentTerms        String    @map("payment_terms") @db.Text
  warranty            String    @map("warranty") @db.Text
  generalTerms        String    @map("general_terms") @db.Text
  jurisdiction        String    @db.Text
  liability           String    @db.Text
  salesTerms          String    @map("sales_terms") @db.Text
  insurance           String    @db.Text
  arbitration         String    @db.Text
  amcNote             String    @map("amc_note") @db.Text

  @@map("quotation_terms")
}
