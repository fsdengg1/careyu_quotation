{
  "name": "careyu-quotation-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CARE YU AUTOMATION quotation generation API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "migration:run": "typeorm -d src/config/data-source.js migration:run",
    "migration:show": "typeorm -d src/config/data-source.js migration:show",
    "migration:revert": "typeorm -d src/config/data-source.js migration:revert"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "puppeteer": "^23.11.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26"
  }
}
